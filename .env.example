# Copy to .env and run: php artisan key:generate
#
# This site has no database. All content lives in config/portfolio.php, and
# sessions only ever hold the chosen language, so cookie sessions and file
# caching are enough - nothing here needs MySQL, Redis or a queue worker.
#
# For production values, see DEPLOY.md.

APP_NAME="Luka Tsurtsumia"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sessions carry the language choice and nothing else, so they live in the
# cookie and the container stays stateless.
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production, where the site is served over HTTPS.
SESSION_SECURE_COOKIE=false

CACHE_STORE=file

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Mail is unused: the contact section opens the visitor's own Gmail compose
# window rather than sending anything from the server.
MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
